<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules (applied via android:fullBackupContent on API <= 30).
   See https://developer.android.com/guide/topics/data/autobackup

   The DataStore preferences live under files/datastore/ and must never leave the
   device via cloud backup. The SQLCipher database and the Keystore-backed secret
   store are not excluded here because their key material is device-bound and
   non-exportable, so a restored copy is undecryptable — the plain DataStore has
   no such protection, hence the exclusion.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
