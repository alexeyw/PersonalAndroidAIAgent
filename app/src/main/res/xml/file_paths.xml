<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider path map. Only the dedicated share-staging directory under the
    app cache (cacheDir/shared/) is exposed; a workspace file is copied there per
    share so the agent workspace itself is never shared directly.
-->
<paths>
    <cache-path
        name="shared"
        path="shared/" />
    <!-- Transient camera-capture files staged here for the TakePicture
         FileProvider URI; the attachment store keeps only the downscaled JPEG. -->
    <cache-path
        name="images"
        path="images/" />
    <!-- Journal exports staged for the share sheet. Deliberately a sibling of
         `shared/` rather than a directory inside it: the Files screen clears the
         whole of `shared/` on every workspace share, which would delete a journal
         export still waiting to be read by the app the user picked. -->
    <cache-path
        name="journal"
        path="journal/" />
</paths>
