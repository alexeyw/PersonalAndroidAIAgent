    <!-- Import / export of a prompt as a Markdown file. There is deliberately
         no user-facing noun for the artefact: the verbs are "Import prompt"
         and "Export prompt", and the file itself is "a Markdown file". A noun
         like "pack" implies a bundle that installs things, which is the exact
         implication this surface must not make. -->
    <string name="prompts_import_cd">Import a prompt from a file</string>
    <string name="prompts_export_cd_format">Export “%1$s” to a file</string>
    <string name="prompts_action_export">Export</string>
    <string name="prompts_action_delete">Delete</string>
    <string name="prompts_import_success_format">Imported “%1$s” into %2$s.</string>
    <string name="prompts_import_success_action">Show</string>
    <string name="prompts_export_success_format">Exported “%1$s”.</string>
    <string name="prompts_import_unchanged_format">“%1$s” is already in your library — nothing changed.</string>
    <string name="prompts_import_unreadable">That file could not be read.</string>

    <!-- Import outcome dialogs. One shape, five bodies. -->
    <string name="prompts_import_left_out_heading">LEFT OUT</string>
    <plurals name="prompts_import_left_out_more">
        <item quantity="one">and %1$d more</item>
        <item quantity="other">and %1$d more</item>
    </plurals>
    <string name="prompts_import_mismatch_title">Imported without some settings</string>
    <string name="prompts_import_mismatch_body_format">“%1$s” was written by a different version of the app. The prompt came across; these settings did not.</string>
    <string name="prompts_import_unknown_keys_body_format">“%1$s” is in your library. Some settings in the file are not ones this app knows, so they were left out.</string>
    <string name="prompts_import_refused_title">Imported as text only</string>
    <string name="prompts_import_refused_body_format">“%1$s” is now in your library. The file also asked to add %2$s — a prompt can only supply wording, so that part was left out.</string>
    <string name="prompts_import_refused_asked_tools">tools</string>
    <string name="prompts_import_refused_asked_steps">steps</string>
    <string name="prompts_import_refused_asked_scripts">scripts</string>
