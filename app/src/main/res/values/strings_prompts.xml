    <string name="prompts_import_refused_scripts_format" tools:ignore="PluralsCandidate">Scripts: %1$d</string>
    <string name="prompts_import_version_left_out_format">Version: %1$d</string>

    <!-- Parse failures: one title, one body per cause. Never "invalid file". -->
    <string name="prompts_import_failed_title">Nothing was imported</string>
    <string name="prompts_import_failed_frontmatter">The settings block at the top of the file is missing or incomplete. It has to sit between two lines of three dashes.</string>
    <string name="prompts_import_failed_duplicate_key">The settings block at the top of the file names the same setting twice, so there is no way to tell which one you meant.</string>
    <string name="prompts_import_failed_missing_key_format">The file is missing something it needs: %1$s.</string>
    <string name="prompts_import_failed_no_prompt">The file has a name but no prompt text, so there is nothing to save.</string>
    <string name="prompts_import_failed_unknown_type_format">The file is for a step type this app does not have: %1$s.</string>
    <string name="prompts_import_failed_not_llm_format">Prompts belong to steps that call a model. This file is for %1$s, which does not.</string>
    <string name="prompts_import_failed_name_too_long_format">The name in the file is longer than %1$d characters.</string>
    <string name="prompts_import_failed_prompt_too_long_format">The prompt in the file is longer than %1$d characters.</string>

